            "description": "Ping da API + Postgres."
          }
        },
        {
          "name": "Documentação HTML",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/docs"
          }
