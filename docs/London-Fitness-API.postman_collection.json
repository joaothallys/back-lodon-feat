{
  "info": {
    "name": "London Fitness API",
    "description": "Collection da API da Academia London Fitness.\n\n**Como usar**\n1. Importe este arquivo no Postman (Import → File).\n2. Rode **Registrar** ou **Login** — o `accessToken` e o `refreshToken` são gravados sozinhos.\n3. As demais rotas já enviam `Authorization: Bearer {{accessToken}}`.\n\nBase URL padrão: `http://127.0.0.1:3000`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "planId", "value": "" },
    { "key": "unitId", "value": "" },
    { "key": "membershipPaymentId", "value": "" },
    { "key": "locationId", "value": "" },
    { "key": "workoutId", "value": "" },
    { "key": "workoutPlanId", "value": "" },
    { "key": "planDayId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "exerciseId", "value": "rosca-direta-barra-reta" },
    { "key": "exerciseExternalId", "value": "" },
    { "key": "masterEmail", "value": "xavier.y@example.org" },
    { "key": "masterPassword", "value": "" },
    { "key": "masterKey", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function saveTokens(json) {",
          "  if (!json) return;",
          "  if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
          "  if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);",
          "  if (json.data && json.data.id) pm.collectionVariables.set('userId', json.data.id);",
          "}",
          "try {",
          "  const json = pm.response.json();",
          "  if (json.accessToken || json.refreshToken) saveTokens(json);",
          "} catch (e) {}"
        ]
      }
    }
  ],
  "item": [
